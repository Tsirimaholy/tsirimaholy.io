# Resend API key for sending contact-form emails
RESEND_API_KEY=

# Cloudflare Turnstile secret for the contact-form widget
# (sitekey: 0x4AAAAAAEk21h3l4jPquaiZ)
# Production: store in Vercel environment variables, never in this file.
TURNSTILE_SECRET=

# Optional comma-separated extra frontend hostnames allowed to submit the form.
# The app already allows localhost/127.0.0.1 in development and
# tsirimaholy.com/www.tsirimaholy.com in production.
TURNSTILE_HOSTNAMES=
