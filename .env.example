# Resend API key for sending contact-form emails
RESEND_API_KEY=

# Cloudflare Turnstile secret for the contact-form widget
# (sitekey: 0x4AAAAAAEk21h3l4jPquaiZ)
# Production: store in Vercel environment variables, never in this file.
TURNSTILE_SECRET=

# Comma-separated allowlist of frontend hostnames allowed to submit the form.
# Local dev: localhost,127.0.0.1
# Production: tsirimaholy.com,www.tsirimaholy.com
TURNSTILE_HOSTNAMES=
